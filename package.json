{
  "name": "@dev-core-ui/components",
  "version": "0.2.44",
  "description": "DevCore reusable UI components",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./theme/*": "./theme/*",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "theme"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "scripts": {
    "build": "tsup && cpy \"src/theme/**/*\" theme",
    "dev": "tsup --watch",
    "release": "standard-version"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cpy-cli": "^6.0.0",
    "esbuild-sass-plugin": "^3.3.1",
    "sass": "^1.80.0",
    "standard-version": "^9.5.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naresha-dev/devcore-ui.git"
  }
}
